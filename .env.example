# Copy to .env and fill in. .env is gitignored — never commit real values.

# Timezone for the scheduler's wall-clock times.
TZ=Asia/Dubai

# Ollama (Parson local AI). With Docker host networking, the container reaches the
# host's Ollama at localhost.
OLLAMA_URL=http://localhost:11434

# At-rest encryption key for secrets stored in the DB (SMTP password, Jira token,
# webhook URL). Must decode (base64 or hex) to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Leave blank to store secrets in plaintext (not recommended).
APP_ENCRYPTION_KEY=

# Optional single-password login gate.
#   AUTH_ENABLED=false  -> open (good for a trusted local machine)
#   AUTH_ENABLED=true   -> require ADMIN_PASSWORD to use the app
AUTH_ENABLED=false
ADMIN_PASSWORD=
# Secret for signing session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Mail defaults that pre-fill the Settings > Email form on a fresh install.
# The SMTP password is entered in the UI and stored encrypted — never put it here.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@example.com
SMTP_FROM=you@example.com
SMTP_TO=team@example.com
SMTP_CC=
SMTP_TEST_TO=you@example.com

# Teams for Linux MQTT broker for the My Teams tab (blank = logger off).
# docker-compose.yml sets this; only needed when running the binary directly.
# MQTT_URL=tcp://localhost:1883
